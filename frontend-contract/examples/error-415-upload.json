{
  "request": {
    "method": "POST",
    "url": "http://127.0.0.1:8765/api/notices/extract-file",
    "headers": {},
    "multipart": {
      "file": {
        "filename": "notice.bin",
        "content-type": "application/octet-stream"
      }
    }
  },
  "response": {
