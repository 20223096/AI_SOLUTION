# 쉿간표 백엔드 API origin (끝에 / 없이)
# - npm run dev: vite.config.ts 프록시 대상 (브라우저는 /api 로 요청 → CORS 없음)
# - npm run build: 빌드 결과물이 직접 요청하는 주소 (백엔드 CORS 허용 필요)
VITE_SHH_API_BASE_URL=http://127.0.0.1:8000
